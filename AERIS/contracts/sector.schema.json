{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeris/sector",
  "type": "object",
  "required": ["id", "capacity", "current_traffic", "forecast_traffic", "utilization_pct"],
  "properties": {
    "id": {"type": "string"}, "capacity": {"type": "integer", "minimum": 0},
    "current_traffic": {"type": "integer", "minimum": 0}, "forecast_traffic": {"type": "integer", "minimum": 0},
    "utilization_pct": {"type": "number", "minimum": 0}
  }
}