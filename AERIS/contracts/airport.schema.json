{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeris/airport",
  "type": "object",
  "required": ["id", "position", "arrival_capacity", "departure_capacity", "operational_status"],
  "properties": {
    "id": {"type": "string"}, "position": {"type": "object", "required": ["lat", "lon"]},
    "arrival_capacity": {"type": "integer"}, "departure_capacity": {"type": "integer"},
    "weather_status": {"type": "string"}, "operational_status": {"type": "string"}
  }
}