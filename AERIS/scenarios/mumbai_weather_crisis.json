{
  "id":"mumbai_weather_crisis_v2",
  "name":"Mumbai Monsoon Multi-Constraint Network Crisis",
  "target_flight_id":"F102",
  "simulation_minutes":35,
  "description":"Synthetic Mumbai-region airline OCC scenario in which weather, airport acceptance, sector loading, temporary airspace restriction, fuel margin and network ripple interact.",
  "events":[
    {"t":0,"event":"baseline"},
    {"t":5,"event":"convective_weather_develops_near_BOM","payload":{"intensity":"HIGH","expand_factor":1.35}},
    {"t":8,"event":"BOM_arrival_capacity_drops","payload":{"arrival_capacity":12}},
    {"t":10,"event":"holding_begins","payload":{"affected_flights":["AI2-01","AI3-01","AI5-01","AI8-01"],"extra_fuel_burn_per_min":0.75}},
    {"t":12,"event":"bypass_sector_approaches_capacity","payload":{"sector_id":"S6","capacity":6}},
    {"t":15,"event":"F102_operational_degradation","payload":{"fuel_remaining_min":51,"status":"DEGRADED"}},
    {"t":17,"event":"generate_5_alternatives"},
    {"t":18,"event":"activate_temporary_restriction","payload":{"restriction_id":"R-MONSOON-01"}},
    {"t":19,"event":"2_candidates_expected_rejected_by_hard_constraints","payload":{"expected":["ALT-C","ALT-E"]}},
    {"t":21,"event":"evaluate_remaining_3"},
    {"t":24,"event":"stress_test_3_futures","payload":{"scenario_count":5}},
    {"t":26,"event":"critic_challenges_leader"},
    {"t":28,"event":"recommend_resilient_option","payload":{}},
    {"t":30,"event":"dispatcher_approval"},
    {"t":32,"event":"verify_network_improvement"},
    {"t":35,"event":"continue_monitoring"}
  ],
  "stress_profiles":[
    {"id":"F1","name":"Weather expansion +10%","weather_expand_factor":1.10},
    {"id":"F2","name":"Weather expansion +20%","weather_expand_factor":1.20},
    {"id":"F3","name":"S6 capacity -15% with future bypass restriction","sector_capacity_factor":{"S6":0.85},"activate_restrictions":["R-FUTURE-S6-01"]},
    {"id":"F4","name":"Traffic demand +15%","traffic_factor":1.15},
    {"id":"F5","name":"BOM acceptance -20%","airport_capacity_factor":{"BOM":0.80}}
  ]
}
